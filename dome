# Ensure main() returns the correct exit code
main() {
  local cmd="${1:-}"
  local exit_code=0
  
  shift || true
  case "$cmd" in
  init) initialize_dome "$@"; exit_code=$? ;;
  sync) perform_sync "$@"; exit_code=$? ;;
  pull) dome_pull; exit_code=$? ;;
  push) dome_push; exit_code=$? ;;
  revert) revert_backup "$@"; exit_code=$? ;;
  validate) validate_config; exit_code=$? ;;
  -v) echo -e "${COLORS[bold]}dome ${DOME_VERSION}${COLORS[reset]}"; exit_code=0 ;;
  -h | *) usage; exit_code=0 ;;
  esac
  
  return $exit_code
}

main "$@"