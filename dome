# Fix sync_files function to return proper exit code
sync_files() {
  local repo_root distro snapshot no_backup verbose backup_dir
  
  if ! repo_root=$(get_repo_root); then
    print_error "Failed to get repository root"
    return 1
  fi

  # Rest of the function remains the same...
  
  [[ "$verbose" == "true" ]] && echo
